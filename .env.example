# ==============================================================================
# Wazzopi - Full-Stack E-Commerce & Coffee Roastery Platform
# Environment Configuration Template
# ==============================================================================

# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default Local Database (SQLite) - Ready to run immediately:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL Database (e.g. Supabase, Neon, Railway, Vercel Postgres):
# If using PostgreSQL, remember to change provider = "postgresql" in prisma/schema.prisma
# DATABASE_URL="postgresql://username:password@ep-cool-db.us-east-1.aws.neon.tech/neondb?sslmode=require"

# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used to sign session JWT cookies (Must be at least 32 characters long).
# You can generate one using: openssl rand -base64 32
AUTH_SECRET="your-super-secret-random-key-change-this-in-production-min-32-chars"

# 3. APPLICATION DOMAIN
# ------------------------------------------------------------------------------
# Base URL of your deployed application (Used for payment callbacks and email links):
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# In production on Vercel:
# NEXT_PUBLIC_APP_URL="https://your-custom-domain.com"

# 4. EMAIL SERVICE (Optional - Transactional Notifications)
# ------------------------------------------------------------------------------
# Option A: Resend API (Recommended for modern cloud deployment)
# Get your API key at: https://resend.com
RESEND_API_KEY=""

# Option B: Custom SMTP Server (Can also be configured via Admin Dashboard Settings)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="orders@yourdomain.com"

# 5. PAYMENT GATEWAYS (Can also be configured via Admin Dashboard Settings)
# ------------------------------------------------------------------------------
# Stripe API Keys (https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""

# PayPal REST API Credentials (https://developer.paypal.com)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Midtrans API Keys (Optional - for Indonesian Rupiah / QRIS)
MIDTRANS_CLIENT_KEY=""
MIDTRANS_SERVER_KEY=""
